# Copy this file to .env and fill in real values. Never commit .env.

# --- Required by the assignment -------------------------------------------
# Comma-separated key pool (at least 2). Ids are key_1, key_2, ... in this order.
# Example used for the demo: two Gemini keys (two Google accounts) + one Groq key.
LLM_API_KEYS=replace_with_gemini_key_1,replace_with_gemini_key_2,replace_with_groq_key
# SQLite location. This value is for running without Docker (file next to the backend).
# docker compose always overrides it to sqlite:////data/app.db on the app_data volume,
# and Render uses sqlite:////data/app.db too.
DATABASE_URL=sqlite:///./app.db
# Comma-separated CORS origins (exact, no trailing slash).
ALLOWED_ORIGINS=http://localhost:3000
# true enables the X-Simulate-Failure test hook.
ENABLE_FAILURE_SIMULATION=true

# --- Model ----------------------------------------------------------------
# Any LiteLLM model string (used for every key unless LLM_KEY_MODELS says otherwise).
LLM_MODEL=gemini/gemini-3.5-flash-lite
# Optional: one model per key, in the same order as LLM_API_KEYS (cross-provider failover).
LLM_KEY_MODELS=gemini/gemini-3.5-flash-lite,gemini/gemini-3.5-flash-lite,groq/openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.3
# Optional: low | medium | high (or "disable" for Gemini 2.5 thinking) to trade quality for speed.
LLM_REASONING_EFFORT=
MAX_HISTORY_MESSAGES=40
# Optional: override the built-in default system prompt.
DEFAULT_SYSTEM_PROMPT=

# --- LiteLLM cache --------------------------------------------------------
# disk (persists on the /data volume) or local (in-memory)
CACHE_TYPE=disk
# Without Docker: a folder next to the backend. Docker/Render use /data/llm_cache.
CACHE_DIR=./llm_cache
CACHE_TTL_SECONDS=86400

# --- Misc -----------------------------------------------------------------
# Optional regex for extra CORS origins, e.g. Vercel previews: https://echo-.*\.vercel\.app
ALLOWED_ORIGIN_REGEX=
ENABLE_DOCS=false
LOG_LEVEL=info

# --- Frontend (docker compose) --------------------------------------------
# URL the browser uses to reach the backend.
PUBLIC_API_URL=http://localhost:8000
